# Example environment variables
DB_DSN=postgresql://whatbot:whatbot@db:5432/whatbot

# Evolution API database configuration
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution@evolution-db:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

# Evolution API runtime config
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_API_INSTANCE_NAME=your_instance_name

# Optional features kept off for a minimal first boot
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=true
QRCODE_LIMIT=30
CONFIG_SESSION_PHONE_CLIENT=Chrome
CONFIG_SESSION_PHONE_NAME=Chrome
# Deixe vazio para buscar versao do WhatsApp Web automaticamente
CONFIG_SESSION_PHONE_VERSION=
NODE_OPTIONS=--dns-result-order=ipv4first

GEMINI_API_KEY=your_gemini_api_key

# LLM: gemini (nuvem) ou ollama (local, sem cota)
LLM_PROVIDER=gemini
# --- Ollama (LLM_PROVIDER=ollama) ---
# Ollama no host Windows/Mac (worker Docker): host.docker.internal
# Ollama no compose (profile ollama): http://ollama:11434
# Ollama no mesmo host que o worker nativo: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Modelos recomendados PT-BR: llama3.2, qwen2.5:3b, gemma2:2b
OLLAMA_MODEL=llama3.2
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite
# false = 1 chamada API com base no prompt (recomendado no tier gratuito)
# true = function calling (2+ chamadas por mensagem, esgota cota rápido)
GEMINI_USE_TOOLS=false
GEMINI_TEMPERATURE=0.1

# Base de conhecimento do negócio (Markdown)
KNOWLEDGE_PATH=knowledge/base.md

# Admin: recebe alertas de fila e comandos secretaria (DDI+DDD+número, vírgula para vários)
ADMIN_NOTIFY_PHONES=5511949305094,5511988887777
NOTIFY_QUEUE_BATCH=5
NOTIFY_LONG_WAIT_MINUTES=15
NOTIFY_IMMEDIATE_ON_HANDOVER=true
NOTIFY_ON_ASSUMIR=true
AUTO_REACTIVATE_HOURS=24
DEFAULT_TEST_PHONE=5511999999999
# Modo teste: responde só a números em TEST_PHONES (admins e #simular continuam normais)
TEST_MODE=false
TEST_PHONES=5511999999999,5511888888888
BUSINESS_PHONE=5511949305094
DAILY_SUMMARY_HOUR=20
WHATBOT_TIMEZONE=America/Sao_Paulo

# Log de mensagens (JSONL) para auditoria e debug da IA
# Caminho relativo = raiz do projeto (/whatbot no Docker, pasta WhatBot no host)
# Deixe vazio para registrar apenas no stdout/container logs
WHATBOT_MESSAGE_LOG_PATH=logs/messages.jsonl
# 0 = texto completo; padrão 2000 caracteres por campo
WHATBOT_MESSAGE_LOG_MAX_CHARS=2000

# --- Instagram (instagram-ingestion-service) ---
# App na Meta ("Instagram API with Instagram Login"): developers.facebook.com
IG_APP_ID=your_instagram_app_id
IG_CLIENT_SECRET=your_instagram_client_secret
# Mesmo valor usado ao validar HMAC-SHA256 do corpo bruto (X-Hub-Signature-256)
IG_APP_SECRET=your_instagram_app_secret
# Token arbitrário escolhido por você, repetido no handshake GET da Meta
IG_WEBHOOK_VERIFY_TOKEN=change-me-webhook-verify-token
# URL de redirect cadastrada no app, usada por scripts/ig_oauth.py
IG_OAUTH_REDIRECT_URI=https://webhook.seudominio.com.br/ig-oauth/callback
# Porta do serviço whatbot/ingress.py (perfil "instagram" do docker-compose.yml)
IG_INGRESS_PORT=8090
# URL usada por scripts/ig_simulate_webhook.py para testar ponta a ponta local
IG_INGRESS_URL=http://localhost:8090/webhook/instagram
# Alertas de saúde da integração (thresholds documentados na spec "instagram")
IG_ALERT_FAIL_STREAK=5
IG_ALERT_SILENCE_MINUTES=120

# --- WhatsApp Cloud API (whatsapp-cloud-channel-client) ---
# Seleciona o cliente registrado sob o canal "whatsapp": "evolution"
# (Baileys, atual/default) ou "cloud" (API oficial da Meta). Trocar para
# "cloud" exige as credenciais abaixo E uma linha em canal_credenciais
# (canal='whatsapp', access_token=<token do System User>,
# account_id=<phone_number_id>) — ver DEPLOYMENT.md.
WHATSAPP_PROVIDER=evolution
# Mesmo protocolo hub.challenge/X-Hub-Signature-256 do Instagram, mas
# credenciais próprias — WhatsApp é um produto/webhook separado no Meta
# Business Manager.
WA_CLOUD_APP_SECRET=your_whatsapp_cloud_app_secret
WA_CLOUD_WEBHOOK_VERIFY_TOKEN=change-me-wa-webhook-verify-token

# Se qualquer valor acima permanecer como placeholder, o app encerra no startup com erro claro.
