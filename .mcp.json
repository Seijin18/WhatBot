{
  "mcpServers": {
    "zen": {
      "command": "${ZEN_MCP_SERVER_HOME}\\venv\\Scripts\\python.exe",
      "args": ["${ZEN_MCP_SERVER_HOME}\\server.py"],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
      }
    },
    "context-mode": {
      "command": "${HOME}/.npm-global/bin/context-mode",
      "args": []
    },
    "codebase-memory": {
      "command": "${HOME}/.npm-global/bin/codebase-memory-mcp",
      "args": []
    }
  }
}
