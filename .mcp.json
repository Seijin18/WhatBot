{
  "mcpServers": {
    "zen": {
      "command": "${ZEN_MCP_SERVER_HOME}\\venv\\Scripts\\python.exe",
      "args": ["${ZEN_MCP_SERVER_HOME}\\run.py"],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
      }
    },
    "context-mode": {
      "command": "npx",
      "args": ["-y", "context-mode"]
    },
    "codebase-memory": {
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp"]
    }
  }
}
